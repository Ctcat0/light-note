<view class="page-shell home-page">
  <view class="page-header">
    <text class="page-title">今天</text>
    <text class="page-description">{{dateLabel}} · 天气、待办和收支都在这里</text>
  </view>

  <view class="snapshot-notice" wx:if="{{snapshotNotice}}">{{snapshotNotice}}</view>
  <view class="page-state-card" wx:if="{{viewState === 'loading'}}"><app-loading message="正在加载今日概览" /></view>
  <view class="page-state-card" wx:elif="{{viewState === 'error'}}"><app-error-state title="首页加载失败" message="{{errorMessage}}" bind:retry="handleRetry" /></view>
  <view class="page-state-card" wx:elif="{{viewState === 'empty'}}"><app-empty title="今天还没有内容" description="可以先记一笔或添加待办" /></view>

  <block wx:else>
    <button class="weather-card" bindtap="handleOpenWeather">
      <view class="card-heading"><text>{{weatherCity}}</text><text class="card-link">切换城市 ›</text></view>
      <view wx:if="{{weatherAvailable}}" class="weather-main">
        <text class="weather-temperature">{{weatherTemperature}}</text>
        <view><text class="weather-condition">{{weatherCondition}}</text><text class="weather-range">今日 {{weatherRange}}</text></view>
      </view>
      <view wx:else class="module-error">{{weatherMessage}}</view>
      <text wx:if="{{weatherAvailable}}" class="weather-time">{{weatherStale ? '缓存天气' : '更新'}} {{weatherUpdated}}</text>
      <text wx:if="{{weatherAvailable}}" class="weather-provider">天气数据：Open-Meteo</text>
    </button>

    <view class="overview-card">
      <view class="card-heading"><text>今日待办</text><button class="card-link" bindtap="handleOpenTodo">查看全部 ›</button></view>
      <view wx:if="{{todosAvailable}}">
        <view class="todo-counts"><text>待完成 {{todayPending}}</text><text>已完成 {{todayCompleted}} / {{todayTotal}}</text><text wx:if="{{overdueCount > 0}}" class="overdue">逾期 {{overdueCount}}</text></view>
        <view wx:if="{{todoItems.length > 0}}" class="home-todos">
          <view wx:for="{{todoItems}}" wx:key="todoId" class="home-todo">
            <button class="todo-check" loading="{{updatingTodoId === item.todoId}}" data-id="{{item.todoId}}" bindtap="handleCompleteTodo">✓</button>
            <text class="todo-title">{{item.title}}</text><text class="todo-due {{item.isOverdue ? 'overdue' : ''}}">{{item.dueDisplay}}</text>
          </view>
        </view>
        <text wx:else class="module-empty">今天没有未完成或逾期待办</text>
      </view>
      <view wx:else class="module-error">{{todosMessage}}</view>
    </view>

    <view class="overview-card ledger-card">
      <view class="card-heading"><text>收支摘要</text><button class="card-link" bindtap="handleOpenLedger">查看流水 ›</button></view>
      <view wx:if="{{ledgerAvailable}}">
        <view class="today-ledger"><view><text>今日支出</text><text class="expense-value">{{todayExpenseDisplay}}</text></view><view><text>今日收入</text><text class="income-value">{{todayIncomeDisplay}}</text></view></view>
        <view class="month-ledger"><text>本月收入 {{monthIncomeDisplay}}</text><text>本月支出 {{monthExpenseDisplay}}</text><text class="balance">结余 {{monthBalanceDisplay}}</text></view>
      </view>
      <view wx:else class="module-error">{{ledgerMessage}}</view>
    </view>

    <view class="quick-actions"><button class="quick-button expense" bindtap="handleAddExpense">记支出</button><button class="quick-button income" bindtap="handleAddIncome">记收入</button><button class="quick-button todo" bindtap="handleAddTodo">加待办</button></view>
  </block>
</view>
