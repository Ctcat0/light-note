.home-page { padding-bottom: 48rpx; }
.page-state-card, .empty-card, .diagnostic-panel { margin-top: 24rpx; overflow: hidden; border: 1rpx solid #e7e9ec; border-radius: 24rpx; background: #fff; }
.summary-card { margin-top: 24rpx; padding: 34rpx 32rpx; border-radius: 26rpx; background: linear-gradient(145deg, #2f6f5e, #245748); color: #fff; box-shadow: 0 14rpx 36rpx rgba(36,87,72,.18); }
.summary-header { display: flex; align-items: flex-start; justify-content: space-between; }
.summary-caption, .balance-amount, .summary-item-label, .summary-item-value { display: block; }
.summary-caption { color: rgba(255,255,255,.72); font-size: 25rpx; }
.balance-amount { margin-top: 12rpx; font-size: 52rpx; font-weight: 700; }
.ledger-link { margin: 0; padding: 0 22rpx; border: 1rpx solid rgba(255,255,255,.32); border-radius: 999rpx; background: rgba(255,255,255,.1); color: #fff; font-size: 24rpx; line-height: 58rpx; }
.summary-grid { display: flex; margin-top: 34rpx; }
.summary-item { flex: 1; padding: 22rpx 24rpx; border-radius: 18rpx; background: rgba(255,255,255,.1); }
.summary-item + .summary-item { margin-left: 18rpx; }
.summary-item-label { color: rgba(255,255,255,.7); font-size: 23rpx; }
.summary-item-value { margin-top: 10rpx; font-size: 31rpx; font-weight: 650; }
.quick-actions { display: flex; margin-top: 24rpx; }
.quick-button { flex: 1; border-radius: 18rpx; font-size: 28rpx; font-weight: 600; }
.quick-button + .quick-button { margin-left: 20rpx; }
.quick-button.expense { background: #fff1ee; color: #a34b3f; }
.quick-button.income { background: #eaf5ef; color: #2f6f5e; }
.empty-card { padding-bottom: 16rpx; }
.diagnostic-panel, .diagnostic-meta { padding: 32rpx; }
.diagnostic-title { display: block; margin-bottom: 20rpx; font-size: 32rpx; font-weight: 600; }
.diagnostic-row { display: flex; justify-content: space-between; padding: 14rpx 0; border-bottom: 1rpx solid #eef0f2; color: #4f555d; font-size: 26rpx; }
.diagnostic-request, .diagnostic-note, .diagnostic-meta text { display: block; margin-top: 18rpx; color: #70757d; font-size: 24rpx; line-height: 1.5; word-break: break-all; }
