.ledger-list-page { padding-bottom: 152rpx; }
.month-card-shell { position: relative; margin-bottom: 68rpx; }
.month-card { padding: 30rpx 32rpx; border-radius: 24rpx; background: linear-gradient(145deg, #2f6f5e, #245748); color: #fff; }
.type-tabs { display: flex; width: 360rpx; margin: 0 auto 22rpx; padding: 6rpx; border-radius: 999rpx; background: rgba(255,255,255,.12); }
.type-tab { flex: 1; padding: 10rpx 0; border-radius: 999rpx; color: rgba(255,255,255,.72); font-size: 26rpx; text-align: center; }
.type-tab.active { background: #fff; color: #245748; font-weight: 650; }
.month-selector { display: flex; align-items: center; justify-content: space-between; }
.month-arrow { width: 72rpx; height: 64rpx; padding: 0; background: rgba(255,255,255,.12); color: #fff; font-size: 46rpx; line-height: 60rpx; }
.month-arrow[disabled] { opacity: .35; }
.month-label { padding: 10rpx 32rpx; font-size: 34rpx; font-weight: 650; }
.summary-label { display: block; margin-top: 34rpx; color: rgba(255,255,255,.75); font-size: 26rpx; }
.summary-amount, .summary-pending { display: block; margin-top: 8rpx; font-size: 54rpx; font-weight: 700; }
.summary-grid { display: grid; grid-template-columns: minmax(0, 1fr) 124rpx minmax(0, 1fr); align-items: end; margin-top: 24rpx; }
.summary-total { min-width: 0; }
.summary-income { grid-column: 1; text-align: left; }
.summary-expense { grid-column: 3; text-align: right; }
.summary-grid-label, .summary-grid-value { display: block; }
.summary-grid-label { color: rgba(255,255,255,.72); font-size: 24rpx; }
.summary-grid-value { margin-top: 6rpx; font-size: 30rpx; font-weight: 650; }
.page-state-card, .empty-card { margin-top: 24rpx; overflow: hidden; border: 1rpx solid #e7e9ec; border-radius: 24rpx; background: #fff; }
.empty-card { padding-bottom: 28rpx; }
.refresh-note, .refresh-error { margin-top: 20rpx; padding: 18rpx 24rpx; border-radius: 14rpx; background: #eef6f3; color: #3e665a; font-size: 25rpx; text-align: center; }
.refresh-error { background: #fff1f0; color: #a83932; }
.inline-button { display: inline-block; margin-left: 16rpx; padding: 0; background: transparent; color: #2f6f5e; font-size: 25rpx; line-height: 1.5; }
.day-group { margin-top: 24rpx; overflow: hidden; border: 1rpx solid #e7e9ec; border-radius: 22rpx; background: #fff; }
.day-header { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx; background: #f7f9f8; }
.day-date { font-size: 30rpx; font-weight: 650; }
.day-weekday { margin-left: 14rpx; color: #7a817e; font-size: 24rpx; }
.day-totals { display: flex; flex-direction: column; align-items: flex-end; gap: 6rpx; color: #5a625f; font-size: 23rpx; }
.transaction-row { display: flex; align-items: center; min-height: 112rpx; padding: 18rpx 28rpx; border-top: 1rpx solid #eef0f2; }
.category-icon { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; border-radius: 18rpx; background: #e8f3ef; color: #2f6f5e; font-size: 27rpx; }
.transaction-main { flex: 1; min-width: 0; margin-left: 20rpx; }
.transaction-title, .transaction-meta { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.transaction-title { font-size: 29rpx; font-weight: 600; }
.transaction-meta { margin-top: 8rpx; color: #818681; font-size: 23rpx; }
.transaction-amount { margin-left: 20rpx; color: #323936; font-size: 30rpx; font-weight: 650; }
.transaction-amount.income { color: #2f7d54; }
.load-footer, .load-more-error, .no-more { margin-top: 24rpx; color: #888f8c; font-size: 24rpx; text-align: center; }
.load-more-error { color: #a83932; }
.ledger-drop-add {
  position: absolute;
  left: 50%;
  bottom: -44rpx;
  z-index: 2;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  width: 96rpx !important;
  min-width: 96rpx;
  height: 96rpx;
  margin: 0 0 0 -48rpx;
  padding: 0;
  transform: rotate(45deg);
  border: 0;
  border-radius: 12rpx 52% 52% 52%;
  background: #245748;
  color: #fff;
  box-shadow: 10rpx 12rpx 24rpx rgba(36, 87, 72, .22);
}

.ledger-drop-symbol {
  transform: rotate(-45deg);
  font-size: 46rpx;
  font-weight: 400;
  line-height: 1;
}
.ledger-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.toolbar-title {
  font-size: 30rpx;
  font-weight: 600;
}

.statistics-entry {
  margin: 0;
  color: #2f6f5e;
  background: #edf5f2;
}

.category-filter-chip {
  display: inline-flex;
  margin: 14rpx 0 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #2f6f5e;
  background: #edf5f2;
  font-size: 24rpx;
}
