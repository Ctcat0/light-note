.todo-page { padding-bottom: 120rpx; }
.todo-header { margin-bottom: 24rpx; }
.view-tabs { margin: -4rpx 0 24rpx; white-space: nowrap; }
.view-tab { display: inline-block; box-sizing: border-box; width: auto !important; min-width: 0; margin: 0 14rpx 0 0; padding: 0 30rpx; border-radius: 999rpx; background: #e9ecef; color: #5f656d; font-size: 26rpx; line-height: 64rpx; }
.view-tab.active { background: #dceee8; color: #216451; font-weight: 650; }
.filter-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; padding: 22rpx 26rpx; border: 1rpx solid #e7e9ec; border-radius: 18rpx; background: #fff; }
.filter-label { color: #737880; font-size: 26rpx; }
.filter-picker { color: #2f6f5e; font-size: 28rpx; }
.todo-create-entry { display: flex; align-items: center; min-height: 88rpx; margin-bottom: 24rpx; padding: 14rpx 20rpx; border: 1rpx dashed #b9d6cc; border-radius: 18rpx; background: #f3f9f6; }
.todo-create-entry-hover { background: #e8f3ef; }
.todo-create-icon { display: flex; flex: 0 0 58rpx; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 18rpx; background: #2f6f5e; color: #fff; font-size: 34rpx; line-height: 58rpx; }
.todo-create-copy { flex: 1; min-width: 0; margin-left: 18rpx; }
.todo-create-title, .todo-create-description { display: block; }
.todo-create-title { color: #245748; font-size: 28rpx; font-weight: 650; }
.todo-create-description { margin-top: 4rpx; color: #76817d; font-size: 23rpx; }
.todo-create-arrow { margin-left: 16rpx; color: #6d8d82; font-size: 40rpx; line-height: 1; }
.todo-list { display: flex; flex-direction: column; gap: 18rpx; }
.todo-card { overflow: hidden; padding: 26rpx 24rpx 18rpx; border: 1rpx solid #e7e9ec; border-radius: 22rpx; background: #fff; }
.todo-card.overdue { border-color: #efc5c1; }
.todo-card.completed { opacity: .72; }
.todo-card-main { display: flex; align-items: flex-start; gap: 20rpx; }
.status-button { display: flex; box-sizing: border-box; flex: 0 0 48rpx; align-items: center; justify-content: center; width: 48rpx !important; min-width: 48rpx; max-width: 48rpx; height: 48rpx; margin: 2rpx 0 0; padding: 0; border: 3rpx solid #2f6f5e; border-radius: 50%; background: #fff; color: #fff; font-size: 28rpx; line-height: 42rpx; }
.completed .status-button { background: #2f6f5e; }
.todo-content { flex: 1; min-width: 0; }
.todo-title-row { display: flex; align-items: center; gap: 12rpx; }
.todo-title { overflow: hidden; color: #25292e; font-size: 31rpx; font-weight: 620; text-overflow: ellipsis; white-space: nowrap; }
.completed .todo-title { text-decoration: line-through; }
.priority { flex: none; padding: 4rpx 10rpx; border-radius: 8rpx; font-size: 21rpx; }
.priority-high { background: #fff0ef; color: #ad3833; }
.priority-medium { background: #fff7df; color: #926a08; }
.priority-low { background: #edf4ff; color: #3d6c9e; }
.todo-description { display: -webkit-box; overflow: hidden; margin-top: 10rpx; color: #6d7279; font-size: 25rpx; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.todo-meta { display: flex; justify-content: space-between; gap: 20rpx; margin-top: 14rpx; color: #8a8f96; font-size: 23rpx; }
.due.danger { color: #b34040; }
.todo-card-actions { display: flex; justify-content: flex-end; gap: 12rpx; margin: 18rpx 0 0 68rpx; padding-top: 14rpx; border-top: 1rpx solid #f0f1f2; }
.card-action { box-sizing: border-box; width: auto !important; min-width: 112rpx; height: 58rpx; margin: 0; padding: 0 20rpx; border-radius: 14rpx; font-size: 24rpx; line-height: 58rpx; }
.edit-action { background: #edf5f2; color: #216451; }
.delete-action { background: #fff3f2; color: #a44b46; }
.load-more { padding: 12rpx 0; }
.load-more-error { padding: 20rpx; border-radius: 14rpx; background: #fff1f0; color: #a83932; text-align: center; font-size: 24rpx; }
.load-more-error button { display: inline-block; width: auto; margin-left: 16rpx; padding: 0; background: transparent; color: #2f6f5e; font-size: 24rpx; line-height: 1.4; }
.list-end { display: block; padding: 20rpx; color: #9a9ea4; text-align: center; font-size: 23rpx; }
