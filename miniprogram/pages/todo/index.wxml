<view class="page-shell todo-page">
  <view class="page-header todo-header">
    <text class="page-title">待办</text>
    <text class="page-description">安排今天与近期任务，完成后轻点圆圈即可标记。</text>
  </view>
  <scroll-view class="view-tabs" scroll-x enhanced show-scrollbar="false">
    <button wx:for="{{views}}" wx:key="value" class="view-tab {{selectedView === item.value ? 'active' : ''}}" data-view="{{item.value}}" bindtap="handleViewChange">{{item.label}}</button>
  </scroll-view>
  <view class="filter-row">
    <text class="filter-label">清单</text>
    <picker mode="selector" range="{{listFilterOptions}}" range-key="name" value="{{selectedListIndex}}" bindchange="handleListFilterChange">
      <view class="filter-picker">{{listFilterOptions[selectedListIndex].name || '全部清单'}}⌄</view>
    </picker>
  </view>
  <view class="todo-create-entry" role="button" aria-label="新建待办" hover-class="todo-create-entry-hover" bindtap="handleAdd">
    <view class="todo-create-icon">＋</view>
    <view class="todo-create-copy">
      <text class="todo-create-title">添加待办</text>
      <text class="todo-create-description">记录一件接下来要完成的事</text>
    </view>
    <text class="todo-create-arrow">›</text>
  </view>
  <view class="page-state-card" wx:if="{{viewState === 'loading'}}"><app-loading message="正在加载待办" /></view>
  <view class="page-state-card" wx:elif="{{viewState === 'error'}}"><app-error-state title="待办加载失败" message="{{errorMessage}}" bind:retry="handleRetry" /></view>
  <view class="page-state-card" wx:elif="{{viewState === 'empty'}}">
    <app-empty title="当前没有待办" description="可以新建任务，或切换日期视图查看其他待办" />
  </view>
  <view class="todo-list" wx:else>
    <view class="todo-card {{item.completed ? 'completed' : ''}} {{item.isOverdue ? 'overdue' : ''}}" wx:for="{{items}}" wx:key="todoId">
      <view class="todo-card-main">
        <button class="status-button" aria-label="{{item.completed ? '标记为未完成' : '标记为已完成'}}" loading="{{mutatingTodoId === item.todoId}}" disabled="{{mutatingTodoId !== ''}}" data-id="{{item.todoId}}" bindtap="handleToggleStatus">{{item.completed ? '✓' : ''}}</button>
        <view class="todo-content" data-id="{{item.todoId}}" bindtap="handleEdit">
          <view class="todo-title-row"><text class="todo-title">{{item.title}}</text><text class="priority {{item.priorityClass}}" wx:if="{{item.priority !== 'none'}}">{{item.priorityLabel}}</text></view>
          <text class="todo-description" wx:if="{{item.description}}">{{item.description}}</text>
          <view class="todo-meta"><text class="due {{item.isOverdue ? 'danger' : ''}}">{{item.isOverdue ? '已逾期 · ' : ''}}{{item.dueLabel}}</text><text>{{item.statusLabel}}</text></view>
        </view>
      </view>
      <view class="todo-card-actions">
        <button class="card-action edit-action" disabled="{{mutatingTodoId !== ''}}" data-id="{{item.todoId}}" bindtap="handleEdit">编辑</button>
        <button class="card-action delete-action" disabled="{{mutatingTodoId !== ''}}" data-id="{{item.todoId}}" bindtap="handleDelete">删除</button>
      </view>
    </view>
    <view class="load-more" wx:if="{{loadingMore}}"><app-loading message="正在加载更多" /></view>
    <view class="load-more-error" wx:elif="{{loadMoreError}}"><text>{{loadMoreError}}</text><button bindtap="handleLoadMoreRetry">重试</button></view>
    <text class="list-end" wx:elif="{{!hasMore}}">已经到底了</text>
  </view>
</view>
