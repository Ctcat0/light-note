.weather-page { padding-bottom: 48rpx; }
.search-card, .weather-card, .page-state-card { margin-top: 24rpx; border: 1rpx solid #e7e9ec; border-radius: 24rpx; background: #fff; overflow: hidden; }
.search-card { padding: 28rpx; }
.search-row { display: flex; gap: 16rpx; }
.city-input { flex: 1; min-width: 0; height: 76rpx; padding: 0 22rpx; border-radius: 16rpx; background: #f4f6f7; font-size: 28rpx; }
.search-button, .location-button { margin: 0; border-radius: 16rpx; font-size: 27rpx; line-height: 76rpx; }
.search-button { width: 150rpx; background: #2f6f5e; color: #fff; }
.location-button { width: 100%; margin-top: 18rpx; background: #eaf5ef; color: #2f6f5e; }
.location-settings-button { width: 100%; margin-top: 14rpx; border: 1rpx solid #d7e7e1; background: #fff; color: #2f6f5e; font-size: 26rpx; line-height: 72rpx; }
.location-hint { display: block; margin-top: 18rpx; color: #6b7178; font-size: 24rpx; line-height: 1.6; }
.location-list { margin-top: 16rpx; border-top: 1rpx solid #eef0f2; }
.location-item { display: flex; width: 100% !important; min-width: 100% !important; max-width: 100% !important; justify-content: space-between; align-items: center; margin: 0; padding: 20rpx 4rpx; border-bottom: 1rpx solid #eef0f2; border-radius: 0; background: transparent; text-align: left; line-height: 1.4; }
.location-name { color: #252a2f; font-size: 27rpx; }
.location-admin { color: #8a9097; font-size: 23rpx; }
.weather-card { padding: 32rpx; background: linear-gradient(145deg, #477f98, #315f76); color: #fff; }
.weather-main { display: flex; align-items: flex-start; justify-content: space-between; }
.weather-city, .weather-condition { display: block; }
.weather-city { font-size: 31rpx; font-weight: 650; }
.weather-condition { margin-top: 12rpx; color: rgba(255,255,255,.76); font-size: 26rpx; }
.weather-temperature { font-size: 72rpx; font-weight: 700; }
.weather-meta { display: flex; gap: 24rpx; margin-top: 28rpx; color: rgba(255,255,255,.82); font-size: 24rpx; }
.cache-notice { display: block; margin-top: 20rpx; padding: 14rpx 18rpx; border-radius: 12rpx; background: rgba(255,225,154,.17); color: #ffecb6; font-size: 23rpx; }
.updated-at { display: block; margin-top: 18rpx; color: rgba(255,255,255,.62); font-size: 22rpx; }
.weather-provider { display: block; margin-top: 10rpx; color: rgba(255,255,255,.58); font-size: 21rpx; }
.forecast-list { margin-top: 28rpx; border-top: 1rpx solid rgba(255,255,255,.18); }
.forecast-item { display: grid; grid-template-columns: 1fr 1fr 1.2fr; padding: 20rpx 0; border-bottom: 1rpx solid rgba(255,255,255,.12); font-size: 25rpx; }
.forecast-item text:last-child { text-align: right; }
