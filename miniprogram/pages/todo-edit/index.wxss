.todo-edit-page { padding-bottom: calc(184rpx + env(safe-area-inset-bottom)); }
.form-card { padding: 32rpx; border: 1rpx solid #e7e9ec; border-radius: 24rpx; background: #fff; }
.field-block { margin-bottom: 28rpx; }
.field-heading { display: flex; justify-content: space-between; margin-bottom: 14rpx; }
.field-label { color: #34383d; font-size: 29rpx; font-weight: 550; }
.field-count { color: #92969c; font-size: 23rpx; }
.text-input, .description-input { box-sizing: border-box; width: 100%; border-radius: 16rpx; background: #f6f7f9; font-size: 29rpx; }
.text-input { height: 88rpx; padding: 0 22rpx; }
.description-input { min-height: 180rpx; padding: 20rpx 22rpx; }
.field-row { display: flex; align-items: center; justify-content: space-between; min-height: 102rpx; border-top: 1rpx solid #eef0f2; }
.picker-value { color: #2f6f5e; font-size: 29rpx; }
.compact { padding: 10rpx 16rpx; border-radius: 12rpx; background: #f2f5f4; }
.field-error { display: block; margin-top: 8rpx; color: #b34040; font-size: 24rpx; }
.submit-error { margin-top: 24rpx; padding: 20rpx; border-radius: 14rpx; background: #fff1f0; color: #a83932; font-size: 25rpx; }
.submit-error button { display: inline-block; width: auto; margin-left: 16rpx; padding: 0; background: transparent; color: #2f6f5e; font-size: 25rpx; line-height: 1.4; }
.todo-form-action-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  box-sizing: border-box;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e7e9ec;
  background: rgba(255, 255, 255, .97);
  box-shadow: 0 -10rpx 30rpx rgba(35, 49, 44, .08);
}
.save-button { width: 100%; height: 88rpx; margin: 0; border-radius: 18rpx; background: #2f6f5e; font-size: 30rpx; font-weight: 650; line-height: 88rpx; }
