page {
  min-height: 100%;
  background: #f6f7f9;
  color: #202428;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button::after {
  border: 0;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 40rpx 32rpx 64rpx;
}

.page-header {
  margin-bottom: 32rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 650;
  line-height: 1.25;
}

.page-description {
  display: block;
  margin-top: 12rpx;
  color: #70757d;
  font-size: 28rpx;
  line-height: 1.6;
}

.page-state-card {
  overflow: hidden;
  border: 1rpx solid #e7e9ec;
  border-radius: 24rpx;
  background: #ffffff;
}

