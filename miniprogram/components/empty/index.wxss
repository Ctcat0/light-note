.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 320rpx;
  padding: 48rpx;
  text-align: center;
}

.symbol {
  color: #a9c3ba;
  font-size: 72rpx;
  line-height: 1;
}

.title {
  margin-top: 24rpx;
  color: #34383d;
  font-size: 30rpx;
  font-weight: 600;
}

.description {
  margin-top: 12rpx;
  color: #858a91;
  font-size: 26rpx;
  line-height: 1.6;
}

