{
  "name": "light-note-miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "轻记微信原生小程序项目骨架",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint \"miniprogram/**/*.ts\" \"shared/**/*.ts\" \"tests/**/*.ts\"",
    "test": "tsx --test tests/money.test.ts tests/date.test.ts tests/error.test.ts tests/project-structure.test.ts",
    "build": "npm run typecheck && npm run lint",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "miniprogram-api-typings": "5.2.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "engines": {
    "node": ">=20"
  }
}
